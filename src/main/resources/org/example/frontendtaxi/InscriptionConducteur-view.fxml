<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane prefWidth="700" prefHeight="440" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.frontendtaxi.InscriptionConducteurController"><children>
 <ScrollPane fitToWidth="true" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"><content><VBox spacing="10" maxWidth="580"><padding><Insets top="20" right="32" bottom="22" left="32"/></padding><Label text="MY TAXI DRIVER / DRIVER" styleClass="eyebrow"/><Label text="Create your driver profile" styleClass="title"/><Label text="Enter your details to continue." styleClass="subtitle"/><HBox spacing="14"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Last name" styleClass="field-label"/><TextField fx:id="nomField" promptText="Your last name" maxWidth="Infinity"/></VBox><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="First name" styleClass="field-label"/><TextField fx:id="prenomField" promptText="Your first name" maxWidth="Infinity"/></VBox></HBox><HBox spacing="14"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Phone" styleClass="field-label"/><TextField fx:id="telephoneField" promptText="Digits only" maxWidth="Infinity"/></VBox><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="City" styleClass="field-label"/><TextField fx:id="villeField" promptText="Your city" maxWidth="Infinity"/></VBox></HBox><HBox spacing="14"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Email" styleClass="field-label"/><TextField fx:id="emailField" promptText="Your email" maxWidth="Infinity"/></VBox></HBox><HBox spacing="14"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Date of birth" styleClass="field-label"/><DatePicker fx:id="dateDeNaissancePicker" maxWidth="Infinity"/></VBox><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Licence number" styleClass="field-label"/><TextField fx:id="numeroPermisField" promptText="Licence number" maxWidth="Infinity"/></VBox></HBox><HBox spacing="14"><VBox spacing="4" HBox.hgrow="ALWAYS"><Label text="Gender" styleClass="field-label"/><ChoiceBox fx:id="sexeChoiceBox" maxWidth="Infinity"><items><FXCollections fx:factory="observableArrayList"><String fx:value="Male"/><String fx:value="Female"/></FXCollections></items></ChoiceBox></VBox></HBox><HBox spacing="10"><Button text="Continue" onAction="#siSuivant"/><Button text="Cancel" onAction="#siAnnuler" styleClass="secondary"/></HBox></VBox></content></ScrollPane></children></AnchorPane>