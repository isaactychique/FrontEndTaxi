<AnchorPane fx:id="accueil" prefWidth="700" prefHeight="440" stylesheets="@styles.css" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.frontendtaxi.AccueilController">
 <children><HBox spacing="22" AnchorPane.topAnchor="32" AnchorPane.bottomAnchor="32" AnchorPane.leftAnchor="32" AnchorPane.rightAnchor="32">
